NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_COLE_SUA_CHAVE_AQUI
CLERK_SECRET_KEY=sk_test_COLE_SUA_CHAVE_AQUI

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
