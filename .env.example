# PostgreSQL
# Deve coincidir com docker-compose.yml (user/senha/db: remtx)
DATABASE_URL="postgresql://remtx:remtx@localhost:5432/remtx?schema=public"

# Clerk — https://dashboard.clerk.com → sua app → API Keys
