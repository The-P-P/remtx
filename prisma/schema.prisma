// REMTX — Schema principal

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum UserRole {
  ADMIN
  ATENDENTE
  FINANCEIRO
  MECANICO
}

enum StatusVeiculo {
  DISPONIVEL
  ALUGADO
  EM_MANUTENCAO
  INATIVO
}

enum StatusLocacao {
  RESERVADA
  ATIVA
  FINALIZADA
  CANCELADA
}

enum TipoEventoAgenda {
  LOCACAO_INICIO
  LOCACAO_FIM_PREVISTO
  LOCACAO_FIM_REAL
  PAGAMENTO_CLIENTE
  ENTREGA_VEICULO
  RETIRADA_VEICULO
  OFICINA_SERVICO
  MANUTENCAO_AGENDADA
  IPVA
  LEMBRETE
  FINANCEIRO
  FINANCIAMENTO_VEICULO
}

enum TipoTransacao {
  ENTRADA
  SAIDA
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  TRANSFERENCIA
  BOLETO
  OUTRO
}

enum AlertaManutencao {
  VERDE
  AMARELO
  VERMELHO
}

enum GravidadeProblema {
  LEVE
  MEDIA
  GRAVE
}

// --- Usuário (sincronizado com Clerk) ---

model User {
  id        String   @id
  email     String   @unique
  nome      String
  role      UserRole @default(ATENDENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// --- Frota ---

model Veiculo {
  id               String        @id @default(cuid())
  placa            String        @unique
  apelido          String?
  marca            String
  modelo           String
  ano              Int
  cor              String?
  kmAtual          Int           @default(0)
  kmProximaRevisao Int
  status           StatusVeiculo @default(DISPONIVEL)
  ipvaVencimento   DateTime?
  observacoes      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  manutencoes       Manutencao[]
  locacoes          Locacao[]
  problemasCronicos ProblemaCronico[]
  eventosAgenda     EventoAgenda[]
  financiamento     FinanciamentoVeiculo?

  @@index([status])
  @@index([placa])
}

model FinanciamentoVeiculo {
  id                  String    @id @default(cuid())
  veiculoId           String    @unique
  instituicao         String?
  valorFinanciado     Decimal   @db.Decimal(12, 2)
  valorEntrada        Decimal   @default(0) @db.Decimal(12, 2)
  saldoDevedor        Decimal   @db.Decimal(12, 2)
  valorParcela        Decimal   @db.Decimal(10, 2)
  totalParcelas       Int
  diaVencimento       Int
  dataPrimeiraParcela DateTime
  ativo               Boolean   @default(true)
  quitadoEm           DateTime?
  observacoes         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  veiculo   Veiculo                 @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  parcelas  ParcelaFinanciamento[]

  @@index([ativo])
  @@index([saldoDevedor])
}

model ParcelaFinanciamento {
  id                String    @id @default(cuid())
  financiamentoId   String
  numero            Int
  valor             Decimal   @db.Decimal(10, 2)
  dataVencimento    DateTime
  dataPagamento     DateTime?
  observacoes       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  financiamento         FinanciamentoVeiculo  @relation(fields: [financiamentoId], references: [id], onDelete: Cascade)
  transacaoFinanceira TransacaoFinanceira?

  @@unique([financiamentoId, numero])
  @@index([financiamentoId])
  @@index([dataVencimento])
  @@index([dataPagamento])
}

// --- Clientes ---

model Cliente {
  id          String   @id @default(cuid())
  nome        String
  cpf         String   @unique
  telefone    String
  email       String?
  endereco    String?
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locacoes     Locacao[]
  eventosAgenda EventoAgenda[]

  @@index([nome])
  @@index([cpf])
}

// --- Locações ---

model Locacao {
  id              String        @id @default(cuid())
  veiculoId       String
  clienteId       String
  dataInicio      DateTime
  dataFimPrevista  DateTime?
  dataFimReal     DateTime?
  kmInicio        Int
  kmFim           Int?
  valorDiaria     Decimal       @db.Decimal(10, 2)
  valorTotal      Decimal?      @db.Decimal(10, 2)
  status          StatusLocacao @default(RESERVADA)
  observacoes     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  veiculo   Veiculo          @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  cliente   Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  parcelas  ParcelaLocacao[]
  eventosAgenda EventoAgenda[]
  transacoesFinanceiras TransacaoFinanceira[]

  @@index([status])
  @@index([veiculoId])
  @@index([clienteId])
  @@index([dataInicio])
}

model ParcelaLocacao {
  id                     String    @id @default(cuid())
  locacaoId              String
  valorBase              Decimal   @default(0) @db.Decimal(10, 2)
  valorJuros             Decimal   @default(0) @db.Decimal(10, 2)
  /** Juros fixados ao reagendar com multa — não zeram quando a nova data é futura. */
  jurosTravados          Decimal   @default(0) @db.Decimal(10, 2)
  valor                  Decimal   @db.Decimal(10, 2)
  dataVencimento         DateTime
  dataVencimentoOriginal DateTime?
  dataPagamento          DateTime?
  pagamentoAjustado      Boolean   @default(false)
  isentarJuros           Boolean   @default(false)
  observacoes            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  locacao            Locacao              @relation(fields: [locacaoId], references: [id], onDelete: Cascade)
  transacaoFinanceira TransacaoFinanceira?

  @@index([locacaoId])
  @@index([dataVencimento])
}

model ConclusaoAgenda {
  id             String           @id @default(cuid())
  chave          String           @unique
  tipo           TipoEventoAgenda
  dataPrevista   DateTime
  concluida      Boolean          @default(false)
  concluidaEm    DateTime?
  reagendadaPara DateTime?
  observacoes    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([dataPrevista])
  @@index([reagendadaPara])
}

model EventoAgenda {
  id          String           @id @default(cuid())
  titulo      String
  descricao   String?
  dataInicio  DateTime
  dataFim     DateTime?
  tipo        TipoEventoAgenda @default(LEMBRETE)
  valor       Decimal?         @db.Decimal(10, 2)
  concluido   Boolean          @default(false)
  veiculoId   String?
  clienteId   String?
  locacaoId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  veiculo Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  locacao Locacao? @relation(fields: [locacaoId], references: [id], onDelete: SetNull)

  @@index([dataInicio])
  @@index([tipo])
  @@index([veiculoId])
}

// --- Manutenção ---

model TipoManutencao {
  id          String   @id @default(cuid())
  nome        String   @unique
  descricao   String?
  intervaloKm Int
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pecasPadrao  PecaPadraoTipo[]
  manutencoes  Manutencao[]
}

model PecaPadraoTipo {
  id               String @id @default(cuid())
  tipoManutencaoId String
  nome             String
  quantidade       Int    @default(1)

  tipoManutencao TipoManutencao @relation(fields: [tipoManutencaoId], references: [id], onDelete: Cascade)

  @@index([tipoManutencaoId])
}

model Manutencao {
  id               String           @id @default(cuid())
  veiculoId        String
  tipoManutencaoId String
  dataRealizada    DateTime
  kmRealizada      Int
  kmProxima        Int
  custo            Decimal?         @db.Decimal(10, 2)
  alerta           AlertaManutencao @default(VERDE)
  observacoes      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  veiculo        Veiculo        @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  tipoManutencao TipoManutencao @relation(fields: [tipoManutencaoId], references: [id], onDelete: Restrict)
  pecas               PecaManutencao[]
  transacaoFinanceira TransacaoFinanceira?

  @@index([veiculoId])
  @@index([tipoManutencaoId])
  @@index([kmProxima])
}

model PecaManutencao {
  id            String   @id @default(cuid())
  manutencaoId  String
  nome          String
  quantidade    Int      @default(1)
  valorUnitario Decimal? @db.Decimal(10, 2)

  manutencao Manutencao @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)

  @@index([manutencaoId])
}

// --- Problemas crônicos ---

model ProblemaCronico {
  id            String            @id @default(cuid())
  veiculoId     String
  descricao     String
  gravidade     GravidadeProblema @default(MEDIA)
  ativo         Boolean           @default(true)
  dataRegistro  DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  @@index([veiculoId])
  @@index([ativo])
}

// --- Financeiro ---

model CategoriaFinanceira {
  id        String        @id @default(cuid())
  nome      String        @unique
  tipo      TipoTransacao
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transacoes TransacaoFinanceira[]
}

model TransacaoFinanceira {
  id             String          @id @default(cuid())
  categoriaId    String
  tipo           TipoTransacao
  valor          Decimal         @db.Decimal(10, 2)
  descricao      String
  data           DateTime
  formaPagamento FormaPagamento?
  parcelaId              String?         @unique
  manutencaoId           String?         @unique
  locacaoId              String?
  parcelaFinanciamentoId String?         @unique
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  categoria            CategoriaFinanceira  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  parcela              ParcelaLocacao?      @relation(fields: [parcelaId], references: [id], onDelete: SetNull)
  manutencao           Manutencao?          @relation(fields: [manutencaoId], references: [id], onDelete: SetNull)
  locacao              Locacao?             @relation(fields: [locacaoId], references: [id], onDelete: SetNull)
  parcelaFinanciamento ParcelaFinanciamento? @relation(fields: [parcelaFinanciamentoId], references: [id], onDelete: SetNull)

  @@index([data])
  @@index([tipo])
  @@index([categoriaId])
  @@index([locacaoId])
}
