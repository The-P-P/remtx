// REMTX — Schema principal

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum UserRole {
  ADMIN
  ATENDENTE
  FINANCEIRO
  MECANICO
}

enum StatusVeiculo {
  DISPONIVEL
  ALUGADO
  EM_MANUTENCAO
  INATIVO
}

enum PorteVeiculo {
  HATCH
  SEDAN
  SUV
  PICAPE
}

enum StatusLocacao {
  RESERVADA
  ATIVA
  FINALIZADA
  CANCELADA
}

enum TipoEventoAgenda {
  LOCACAO_INICIO
  LOCACAO_FIM_PREVISTO
  LOCACAO_FIM_REAL
  PAGAMENTO_CLIENTE
  CAUCAO_LOCACAO
  ENTREGA_VEICULO
  RETIRADA_VEICULO
  OFICINA_SERVICO
  MANUTENCAO_AGENDADA
  IPVA
  LEMBRETE
  FINANCEIRO
  FINANCIAMENTO_VEICULO
}

enum TipoTransacao {
  ENTRADA
  SAIDA
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  TRANSFERENCIA
  BOLETO
  OUTRO
}

enum AlertaManutencao {
  VERDE
  AMARELO
  VERMELHO
}

enum GravidadeProblema {
  LEVE
  MEDIA
  GRAVE
}

enum TipoModeloContrato {
  PADRAO
  PLANO_CONQUISTA
}

enum StatusContratoDocumento {
  RASCUNHO
  GERADO
}

enum StatusPlanoConquista {
  ATIVO
  CONCLUIDO
  CANCELADO
}

enum PeriodicidadePagamento {
  SEMANAL
  MENSAL
}

// --- Locadora (tenant — cada conta Clerk = uma locadora) ---

model Locadora {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  veiculos              Veiculo[]
  clientes              Cliente[]
  locacoes              Locacao[]
  tiposManutencao       TipoManutencao[]
  categoriasFinanceiras CategoriaFinanceira[]
  configuracao          ConfiguracaoLocadora?
  conclusoesAgenda      ConclusaoAgenda[]
  eventosAgenda         EventoAgenda[]
  contratos             ContratoLocacao[]

  @@index([nome])
}

// --- Usuário (sincronizado com Clerk) ---

model User {
  id         String   @id
  locadoraId String
  email      String   @unique
  nome       String
  role       UserRole @default(ADMIN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  locadora Locadora @relation(fields: [locadoraId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([locadoraId])
}

// --- Frota ---

model Veiculo {
  id               String        @id @default(cuid())
  locadoraId       String
  placa            String
  apelido          String?
  marca            String
  modelo           String
  ano              Int
  cor              String?
  renavam          String?
  porte            PorteVeiculo  @default(SEDAN)
  valorCompra      Decimal?      @db.Decimal(12, 2)
  dataCompra       DateTime?
  kmAtual          Int           @default(0)
  kmProximaRevisao Int
  status           StatusVeiculo @default(DISPONIVEL)
  ipvaVencimento   DateTime?
  observacoes      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  manutencoes       Manutencao[]
  locacoes          Locacao[]
  problemasCronicos ProblemaCronico[]
  eventosAgenda     EventoAgenda[]
  financiamento     FinanciamentoVeiculo?

  locadora Locadora @relation(fields: [locadoraId], references: [id], onDelete: Cascade)

  @@unique([locadoraId, placa])
  @@index([status])
  @@index([placa])
  @@index([locadoraId])
}

model FinanciamentoVeiculo {
  id                  String    @id @default(cuid())
  veiculoId           String    @unique
  instituicao         String?
  valorFinanciado     Decimal   @db.Decimal(12, 2)
  valorEntrada        Decimal   @default(0) @db.Decimal(12, 2)
  saldoDevedor        Decimal   @db.Decimal(12, 2)
  valorParcela        Decimal   @db.Decimal(10, 2)
  totalParcelas       Int
  diaVencimento       Int
  dataPrimeiraParcela DateTime
  ativo               Boolean   @default(true)
  quitadoEm           DateTime?
  observacoes         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  veiculo   Veiculo                 @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  parcelas  ParcelaFinanciamento[]

  @@index([ativo])
  @@index([saldoDevedor])
}

model ParcelaFinanciamento {
  id                String    @id @default(cuid())
  financiamentoId   String
  numero            Int
  valor             Decimal   @db.Decimal(10, 2)
  dataVencimento    DateTime
  dataPagamento     DateTime?
  observacoes       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  financiamento         FinanciamentoVeiculo  @relation(fields: [financiamentoId], references: [id], onDelete: Cascade)
  transacaoFinanceira TransacaoFinanceira?

  @@unique([financiamentoId, numero])
  @@index([financiamentoId])
  @@index([dataVencimento])
  @@index([dataPagamento])
}

// --- Clientes ---

model Cliente {
  id          String   @id @default(cuid())
  locadoraId  String
  nome        String
  cpf         String
  telefone    String
  email       String?
  endereco    String?
  rg          String?
  rgOrgao     String?
  nacionalidade String? @default("brasileiro")
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locacoes          Locacao[]
  planosConquista   PlanoConquista[]
  eventosAgenda     EventoAgenda[]

  locadora Locadora @relation(fields: [locadoraId], references: [id], onDelete: Cascade)

  @@unique([locadoraId, cpf])
  @@index([nome])
  @@index([cpf])
  @@index([locadoraId])
}

// --- Locações ---

model Locacao {
  id              String        @id @default(cuid())
  locadoraId      String
  veiculoId       String
  clienteId       String
  dataInicio      DateTime
  dataFimPrevista  DateTime?
  dataFimReal     DateTime?
  kmInicio        Int
  kmFim           Int?
  valorDiaria     Decimal       @db.Decimal(10, 2)
  valorCaucao     Decimal       @default(0) @db.Decimal(10, 2)
  caucaoPaga      Boolean       @default(false)
  caucaoDataPagamento DateTime?
  valorTotal      Decimal?      @db.Decimal(10, 2)
  status          StatusLocacao @default(RESERVADA)
  modeloContrato  TipoModeloContrato      @default(PADRAO)
  periodicidadePagamento PeriodicidadePagamento @default(SEMANAL)
  numeroContrato  String?
  planoConquistaMeses Int?
  planoConquistaValorAdesao Decimal? @db.Decimal(12, 2)
  observacoes     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  locadora  Locadora         @relation(fields: [locadoraId], references: [id], onDelete: Cascade)
  veiculo   Veiculo          @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  cliente   Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  parcelas  ParcelaLocacao[]
  contrato  ContratoLocacao?
  planoConquista PlanoConquista?
  eventosAgenda EventoAgenda[]
  transacoesFinanceiras TransacaoFinanceira[]

  @@unique([locadoraId, numeroContrato])
  @@index([status])
  @@index([modeloContrato])
  @@index([veiculoId])
  @@index([clienteId])
  @@index([locadoraId])
  @@index([dataInicio])
}

model ConfiguracaoLocadora {
  id              String   @id
  locadoraId      String   @unique
  razaoSocial     String
  cpfCnpj         String
  rg              String?
  rgOrgao         String?
  endereco        String
  cidade          String   @default("São Luís")
  uf              String   @default("MA")
  cep             String?
  multaRescisao   Decimal  @default(750) @db.Decimal(10, 2)
  kmSemanalMax    Int      @default(1500)
  valorKmExtra    Decimal  @default(1) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  locadora Locadora @relation(fields: [locadoraId], references: [id], onDelete: Cascade)
}

model ContratoLocacao {
  id            String                  @id @default(cuid())
  locadoraId    String
  locacaoId     String                  @unique
  numero        String
  modelo        TipoModeloContrato
  status        StatusContratoDocumento @default(GERADO)
  dadosSnapshot Json
  geradoEm      DateTime                @default(now())
  versao        Int                     @default(1)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  locadora Locadora @relation(fields: [locadoraId], references: [id], onDelete: Cascade)
  locacao  Locacao  @relation(fields: [locacaoId], references: [id], onDelete: Cascade)

  @@unique([locadoraId, numero])
  @@index([modelo])
  @@index([numero])
  @@index([locadoraId])
}

model PlanoConquista {
  id                    String               @id @default(cuid())
  clienteId             String
  locacaoId             String               @unique
  status                StatusPlanoConquista @default(ATIVO)
  totalMeses            Int                  @default(24)
  mesesPagos            Int                  @default(0)
  valorMensal           Decimal              @db.Decimal(10, 2)
  valorAdesao           Decimal              @db.Decimal(12, 2)
  valorAdesaoPago       Decimal              @default(0) @db.Decimal(12, 2)
  adesaoPaga            Boolean              @default(false)
  dataInicio            DateTime
  dataPrevistaConclusao DateTime?
  dataConclusao         DateTime?
  observacoes           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  cliente   Cliente                  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  locacao   Locacao                  @relation(fields: [locacaoId], references: [id], onDelete: Cascade)
  registros PlanoConquistaRegistro[]

  @@index([clienteId])
  @@index([status])
}

model PlanoConquistaRegistro {
  id             String    @id @default(cuid())
  planoId        String
  mesNumero      Int
  valor          Decimal   @db.Decimal(10, 2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  parcelaId      String?   @unique
  observacao     String?
  createdAt      DateTime  @default(now())

  plano   PlanoConquista  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  parcela ParcelaLocacao? @relation(fields: [parcelaId], references: [id], onDelete: SetNull)

  @@unique([planoId, mesNumero])
  @@index([planoId])
}

model ParcelaLocacao {
  id                     String    @id @default(cuid())
  locacaoId              String
  valorBase              Decimal   @default(0) @db.Decimal(10, 2)
  valorJuros             Decimal   @default(0) @db.Decimal(10, 2)
  /** Juros fixados ao reagendar com multa — não zeram quando a nova data é futura. */
  jurosTravados          Decimal   @default(0) @db.Decimal(10, 2)
  valor                  Decimal   @db.Decimal(10, 2)
  dataVencimento         DateTime
  dataVencimentoOriginal DateTime?
  dataPagamento          DateTime?
  pagamentoAjustado      Boolean   @default(false)
  isentarJuros           Boolean   @default(false)
  observacoes            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  locacao                 Locacao                  @relation(fields: [locacaoId], references: [id], onDelete: Cascade)
  transacaoFinanceira     TransacaoFinanceira?
  registroPlanoConquista  PlanoConquistaRegistro?

  @@index([locacaoId])
  @@index([dataVencimento])
}

model ConclusaoAgenda {
  id             String           @id @default(cuid())
  locadoraId     String
  chave          String
  tipo           TipoEventoAgenda
  dataPrevista   DateTime
  concluida      Boolean          @default(false)
  concluidaEm    DateTime?
  reagendadaPara DateTime?
  observacoes    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  locadora Locadora @relation(fields: [locadoraId], references: [id], onDelete: Cascade)

  @@unique([locadoraId, chave])
  @@index([dataPrevista])
  @@index([reagendadaPara])
  @@index([locadoraId])
}

model EventoAgenda {
  id          String           @id @default(cuid())
  locadoraId  String
  titulo      String
  descricao   String?
  dataInicio  DateTime
  dataFim     DateTime?
  tipo        TipoEventoAgenda @default(LEMBRETE)
  valor       Decimal?         @db.Decimal(10, 2)
  concluido   Boolean          @default(false)
  veiculoId   String?
  clienteId   String?
  locacaoId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  veiculo Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  locacao  Locacao?  @relation(fields: [locacaoId], references: [id], onDelete: SetNull)
  locadora Locadora  @relation(fields: [locadoraId], references: [id], onDelete: Cascade)

  @@index([dataInicio])
  @@index([tipo])
  @@index([veiculoId])
  @@index([locadoraId])
}

// --- Manutenção ---

model TipoManutencao {
  id          String   @id @default(cuid())
  locadoraId  String
  nome        String
  descricao   String?
  intervaloKm Int
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pecasPadrao  PecaPadraoTipo[]
  manutencoes  Manutencao[]

  locadora Locadora @relation(fields: [locadoraId], references: [id], onDelete: Cascade)

  @@unique([locadoraId, nome])
  @@index([locadoraId])
}

model PecaPadraoTipo {
  id               String @id @default(cuid())
  tipoManutencaoId String
  nome             String
  quantidade       Int    @default(1)

  tipoManutencao TipoManutencao @relation(fields: [tipoManutencaoId], references: [id], onDelete: Cascade)

  @@index([tipoManutencaoId])
}

model Manutencao {
  id               String           @id @default(cuid())
  veiculoId        String
  tipoManutencaoId String
  dataRealizada    DateTime
  kmRealizada      Int
  kmProxima        Int
  custo            Decimal?         @db.Decimal(10, 2)
  alerta           AlertaManutencao @default(VERDE)
  observacoes      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  veiculo        Veiculo        @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  tipoManutencao TipoManutencao @relation(fields: [tipoManutencaoId], references: [id], onDelete: Restrict)
  pecas               PecaManutencao[]
  transacaoFinanceira TransacaoFinanceira?

  @@index([veiculoId])
  @@index([tipoManutencaoId])
  @@index([kmProxima])
}

model PecaManutencao {
  id            String   @id @default(cuid())
  manutencaoId  String
  nome          String
  quantidade    Int      @default(1)
  valorUnitario Decimal? @db.Decimal(10, 2)

  manutencao Manutencao @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)

  @@index([manutencaoId])
}

// --- Problemas crônicos ---

model ProblemaCronico {
  id            String            @id @default(cuid())
  veiculoId     String
  descricao     String
  gravidade     GravidadeProblema @default(MEDIA)
  ativo         Boolean           @default(true)
  dataRegistro  DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  @@index([veiculoId])
  @@index([ativo])
}

// --- Financeiro ---

model CategoriaFinanceira {
  id         String        @id @default(cuid())
  locadoraId String
  nome       String
  tipo      TipoTransacao
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transacoes TransacaoFinanceira[]

  locadora Locadora @relation(fields: [locadoraId], references: [id], onDelete: Cascade)

  @@unique([locadoraId, nome])
  @@index([locadoraId])
}

model TransacaoFinanceira {
  id             String          @id @default(cuid())
  categoriaId    String
  tipo           TipoTransacao
  valor          Decimal         @db.Decimal(10, 2)
  descricao      String
  data           DateTime
  formaPagamento FormaPagamento?
  parcelaId              String?         @unique
  manutencaoId           String?         @unique
  locacaoId              String?
  parcelaFinanciamentoId String?         @unique
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  categoria            CategoriaFinanceira  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  parcela              ParcelaLocacao?      @relation(fields: [parcelaId], references: [id], onDelete: SetNull)
  manutencao           Manutencao?          @relation(fields: [manutencaoId], references: [id], onDelete: SetNull)
  locacao              Locacao?             @relation(fields: [locacaoId], references: [id], onDelete: SetNull)
  parcelaFinanciamento ParcelaFinanciamento? @relation(fields: [parcelaFinanciamentoId], references: [id], onDelete: SetNull)

  @@index([data])
  @@index([tipo])
  @@index([categoriaId])
  @@index([locacaoId])
}
